{
  "manifest_version": 3,
  "name": "数院四栏通知",
  "version": "1.1",
  "description": "在 MathSmart 首页显示四栏通知和常用服务。",
  "host_permissions": ["http://portal.math.pku.edu.cn/*"],
  "action": { "default_title": "打开数院四栏版" },
  "background": { "service_worker": "return-to-classic.js" },
  "content_scripts": [{
    "matches": ["https://mathsmart.pku.edu.cn/*"],
    "css": ["portal.css"],
    "js": ["portal.js"]
  }],
  "web_accessible_resources": [{
    "resources": ["college-logo.png"],
    "matches": ["https://mathsmart.pku.edu.cn/*"]
  }]
}
